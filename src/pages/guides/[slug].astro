---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import SideRail from '../../components/SideRail.astro';
import { guides } from '../../content/guides';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { pagePhoto } from '../../lib/photos';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const bodies = import.meta.glob<{ Content: any }>('../../content/guides/*.md', { eager: true });
const body = bodies[`../../content/guides/${guide.slug}.md`];
const Content = body.Content;
const ctaPhoto = pagePhoto('hero-roofline', 'Illustration of a row of house rooflines at dusk');
---

<Layout title={guide.title} description={guide.description} fullTitle>
  <Fragment slot="head">
    {guide.schema.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </Fragment>

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <nav class="guide-crumbs text-sm text-muted" aria-label="Breadcrumb">
            <a class="text-link" href="/">Home</a>{" "}<span aria-hidden="true">/</span>{" "}
            <a class="text-link" href="/guides">Guides</a>
          </nav>
          <article class="guide-prose measure">
            <h1>{guide.h1}</h1>
            <Content />
          </article>
        </div>
      </section>
      <FaqAccordion items={guide.faqs} heading="Common questions" />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={ctaPhoto} heading="Tell us about your roof" />
</Layout>
